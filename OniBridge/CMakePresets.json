{
  "version": 6,
  "configurePresets": [
    {"name": "base", "hidden": true, "generator": "Ninja", "binaryDir": "${sourceDir}/build/${presetName}", "cacheVariables": {"CMAKE_EXPORT_COMPILE_COMMANDS": "ON", "ONIBRIDGE_BUILD_TESTS": "ON"}},
    {"name": "linux-debug", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_CXX_COMPILER": "clang++"}},
    {"name": "linux-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "CMAKE_CXX_COMPILER": "clang++", "ONIBRIDGE_BUILD_PLUGIN": "ON"}},
    {"name": "linux-asan", "inherits": "linux-debug", "cacheVariables": {"CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer", "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address"}},
    {"name": "linux-ubsan", "inherits": "linux-debug", "cacheVariables": {"CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-omit-frame-pointer", "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"}},
    {"name": "windows-debug", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "windows-release", "inherits": "base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "ONIBRIDGE_BUILD_PLUGIN": "ON"}}
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "linux-release", "configurePreset": "linux-release"},
    {"name": "linux-asan", "configurePreset": "linux-asan"},
    {"name": "linux-ubsan", "configurePreset": "linux-ubsan"},
    {"name": "windows-debug", "configurePreset": "windows-debug"},
    {"name": "windows-release", "configurePreset": "windows-release"}
  ],
  "testPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug", "output": {"outputOnFailure": true}},
    {"name": "linux-release", "configurePreset": "linux-release", "output": {"outputOnFailure": true}},
    {"name": "linux-asan", "configurePreset": "linux-asan", "output": {"outputOnFailure": true}},
    {"name": "linux-ubsan", "configurePreset": "linux-ubsan", "output": {"outputOnFailure": true}},
    {"name": "windows-debug", "configurePreset": "windows-debug", "output": {"outputOnFailure": true}},
    {"name": "windows-release", "configurePreset": "windows-release", "output": {"outputOnFailure": true}}
  ]
}

